# ============================================================
# APP WEB — DIARIOS OFICIALES
# Copia este archivo como .env.local para desarrollo local.
# En Vercel agrega las mismas variables en Project Settings >
# Environment Variables.
# ============================================================

# SERVER-ONLY. NO uses NEXT_PUBLIC_ para esta credencial.
# Puedes reutilizar el MISMO JSON de la Service Account que ya usa
# el GitHub Action, siempre que tenga acceso de lectura al Sheet y Drive.
# Pega el JSON completo en una sola línea.
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"TU_PROJECT_ID","private_key_id":"TU_PRIVATE_KEY_ID","private_key":"-----BEGIN PRIVATE KEY-----\\nTU_CLAVE\\n-----END PRIVATE KEY-----\\n","client_email":"TU_SERVICE_ACCOUNT@TU_PROJECT_ID.iam.gserviceaccount.com","client_id":"TU_CLIENT_ID","token_uri":"https://oauth2.googleapis.com/token"}

# Registro consolidado que ya usa el proyecto.
GOOGLE_SHEET_ID=TU_GOOGLE_SHEET_ID

# Pestañas del Sheet.
GOOGLE_SHEET_MONITOR_TAB=Monitor
GOOGLE_SHEET_ANALYSIS_TAB=Analisis
